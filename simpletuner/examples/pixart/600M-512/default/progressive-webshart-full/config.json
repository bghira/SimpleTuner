{
    "model_family": "pixart",
    "model_flavour": "600M-512",
    "model_type": "full",
    "data_backend_config": "config/examples/pixart/600M-512/default/progressive-webshart-full/dataloader.json",
    "output_dir": "output/examples/pixart-progressive-webshart",
    "train_batch_size": 1,
    "gradient_accumulation_steps": 1,
    "gradient_checkpointing": true,
    "mixed_precision": "bf16",
    "optimizer": "torch-adamw",
    "learning_rate": 1e-05,
    "lr_scheduler": "constant",
    "max_train_steps": 1500,
    "num_train_epochs": 0,
    "checkpoint_step_interval": 500,
    "resolution": 512,
    "resolution_type": "pixel",
    "aspect_bucket_alignment": 64,
    "data_backend_sampling": "uniform",
    "dataloader_prefetch": true,
    "dataloader_prefetch_qlen": 2,
    "vae_cache_disable": true,
    "validation_disable": true,
    "push_to_hub": false,
    "report_to": "none",
    "seed": 42
}
